# transak (frontend env only — credentials are server-side now)
# the api key lives ONLY in backend/.env. the frontend never sees it: the
# backend mints a signed widget URL via transak's session endpoint and the
# frontend just opens it. VITE_TRANSAK_ENV is still used to know which iframe
# origin to trust for postMessage validation.
#
# STAGING until KYB approval, then PRODUCTION.
# STAGING widget runs on https://global-stg.transak.com.
VITE_TRANSAK_ENV=STAGING

# mtpelerin (frontend, public by design)
# activation key — embedded in widget URL. get from integrate@mtpelerin.com.
# the special key bec6626e-8913-497d-9835-6e6ae9edb144 works only on
# localhost (5173/3000/3001/8080) for dev — use it until your real key arrives.
VITE_MTPELERIN_CTKN=
VITE_MTPELERIN_ENV=STAGING

# topper (frontend env only — signing keys live on the backend)
# the bootstrap JWT is minted by the backend and fetched per session.
VITE_TOPPER_ENV=STAGING

# backend
# base URL of the backend (webhook + orders API + topper bootstrap). leave
# blank in dev to default to http://localhost:3001.
VITE_API_BASE_URL=http://localhost:3001


# mock mode — DEVELOPER USE ONLY.
# set to true ONLY for offline UI work without a backend or provider keys.
# in any deployed / staging / production environment this MUST be false (or
# unset, which equals false). when true:
#   - SwapWidget shows a mocked TransactionFlow instead of the real widget
#   - history shows seed data (clearly badged "Demo data")
# the badge is meant to make mock mode obvious — but don't rely on it.
# keep this off everywhere except a developer's local machine.
VITE_USE_MOCK=false

# Features pending provider approval or stronger ownership proof.
VITE_ENABLE_PAY=false

# Reown AppKit (WalletConnect v2). Create a project at
# https://dashboard.reown.com.
# this value is PUBLIC by design — appears in the bundle. it identifies
# our project for rate limiting + analytics on Reown's side.
# register your own when deploying to a real domain (the dashboard
# allowlists origins, so a stolen projectId can't be reused on
# attacker.com).
VITE_REOWN_PROJECT_ID=
