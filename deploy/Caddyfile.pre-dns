# Staging configuration used before app.onoff.finance points to this VPS.
# The public app host remains on the previous provider; loopback serves the
# staged release for health checks without triggering premature ACME issuance.
{
	email admin@onoff.finance
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

api.onoff.finance {
	encode zstd gzip
	import security_headers
	reverse_proxy 127.0.0.1:3001
}

http://onoff.finance, http://www.onoff.finance {
	redir https://app.onoff.finance{uri} permanent
}

http://app.onoff.finance {
	encode zstd gzip
	import security_headers
	root * /var/www/onoff/current
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

http://127.0.0.1:8081 {
	bind 127.0.0.1
	root * /var/www/onoff/current
	try_files {path} /index.html
	file_server
}
