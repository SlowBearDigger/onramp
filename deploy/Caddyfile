# OnOff Finance frontend and API. DNS cutover is intentionally external to
# this file; validate the local preview on 127.0.0.1:8081 first.

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

api.onoff.finance {
	encode zstd gzip
	import security_headers
	reverse_proxy 127.0.0.1:3001
}

onoff.finance {
	encode zstd gzip
	import security_headers
	root * /var/www/onoff/current
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

www.onoff.finance, app.onoff.finance {
	redir https://onoff.finance{uri} permanent
}

# Local non-TLS preview used by deploy and health-check scripts. UFW does not
# expose this port; Caddy binds it only to loopback.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	root * /var/www/onoff/current
	try_files {path} /index.html
	file_server
}
