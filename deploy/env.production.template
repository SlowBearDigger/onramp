# OnOff Finance backend — production env for the VPS.
#
# Install as /etc/onoff/backend.env and fill in. NEVER commit this file with
# real values.
#
# FASTEST PATH: install your existing environment as /etc/onoff/backend.env and
# change only the three VPS-specific lines below (referrer, DB_PATH, CORS_ORIGIN).

# --- Transak (STAGING for now; swap to production creds at real launch) ---
TRANSAK_ENV=STAGING
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_PARTNER_ACCESS_TOKEN=
# ⬇ VPS-specific: the frontend origin Transak treats as the referrer
# Keep app.onoff.finance until the DNS cutover; switch to the apex together
# with deploy/Caddyfile after Transak has allowlisted the new referrer.
TRANSAK_REFERRER_DOMAIN=https://app.onoff.finance
TRANSAK_WEBHOOK_INSECURE=false

# --- Guardarian (production key) ---
GUARDARIAN_API_KEY=

# --- Topper (leave blank until approved) ---
TOPPER_ENV=STAGING
TOPPER_WIDGET_ID=
TOPPER_KEY_ID=
TOPPER_PRIVATE_KEY_JWK=
TOPPER_PUBLIC_KEY_JWK=

# --- Mt Pelerin ---
MTPELERIN_ENV=STAGING

# --- Admin dashboard (rotate before any real deployment) ---
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# --- Server ---
PORT=3001
# Keep Node private; Caddy is the only public HTTP entry point.
HOST=127.0.0.1

# ⬇ VPS-specific: durable SQLite path (systemd grants write to /var/lib/onramp)
DB_PATH=/var/lib/onramp/data.db
# ⬇ VPS-specific: allowed frontend origins (comma-separated, NO spaces)
CORS_ORIGIN=https://app.onoff.finance,https://onoff.finance,https://www.onoff.finance
