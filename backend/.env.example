# transak
TRANSAK_ENV=STAGING                   # STAGING | PRODUCTION
TRANSAK_API_KEY=                      # request from transak partner support
TRANSAK_PARTNER_ACCESS_TOKEN=         # SECRET; never expose to frontend
# referrer domain transak uses to authorize the widget URL. for local dev
# use http://localhost:5173. for prod use the deployed URL where the
# frontend runs (e.g. https://slowbeardigger.dev).
TRANSAK_REFERRER_DOMAIN=http://localhost:5173

# dev-only escape hatch: decode webhook JWT without verifying signature.
# use only while confirming the algo with transak. set to 'false' or unset
# in production. boot will fail if this is true while NODE_ENV=production
# or TRANSAK_ENV=PRODUCTION.
TRANSAK_WEBHOOK_INSECURE=false

# topper
# all four values must be set together. set NONE to leave topper disabled
# (bootstrap and webhook endpoints will return 503).
# request these from topper during onboarding (see docs/PROVIDERS.md).
TOPPER_ENV=STAGING                    # STAGING | PRODUCTION
TOPPER_WIDGET_ID=                     # public widget id (sub claim of bootstrap JWT)
TOPPER_KEY_ID=                        # kid header of bootstrap JWT
TOPPER_PRIVATE_KEY_JWK=               # SECRET; full JWK as JSON string. used to sign bootstrap JWTs.
TOPPER_PUBLIC_KEY_JWK=                # JWK as JSON string. used to verify X-Topper-JWS-Signature.

# mtpelerin
# no credentials live on the backend — mtpelerin doesn't expose webhooks.
# the frontend forwards postMessage events to /api/providers/mtpelerin/event
# and they're stored with unverified=1.
MTPELERIN_ENV=STAGING                 # STAGING | PRODUCTION

# admin dashboard
# all three values must be set together. set NONE to leave the dashboard
# disabled (every /api/admin/* endpoint will return 503).
# generate the password hash with:
#   echo -n 'YourLongPassword' | node bin/hash-admin-password.js
# the JWT secret signs admin session tokens — must be at least 32 chars.
# rotate it to invalidate all live admin sessions.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# server
PORT=3001
CORS_ORIGIN=http://localhost:5173,https://slowbeardigger.dev
# optional override for the SQLite file location. default: backend/data.db
# DB_PATH=/var/data/offramp.db
